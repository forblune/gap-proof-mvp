# 빌드 시점(build-time)에 필요한 공개 설정 — 값은 넣지 말고 이 파일은 이름만 남긴다.
#
# ── 왜 .dev.vars 가 아니라 이 파일인가 ────────────────────────────────────────
# 두 종류를 구분해야 한다. 이걸 혼동해서 운영에서 계정 기능이 통째로 꺼져 있었다.
#
#   .dev.vars        Cloudflare Worker 의 **런타임** 비밀값. 서버 코드가 요청을 처리할 때
#                    readServerEnv() 로 읽는다. 브라우저에 나가지 않는다.
#                    예: UPSTAGE_API_KEY, GEMINI_API_KEY, GATE_SESSION_SECRET
#                    → 이 파일에 NEXT_PUBLIC_* 을 적어도 **빌드에는 전달되지 않는다.**
#
#   .env / .env.local  Vite(vinext) 가 **빌드할 때** 읽는 값. NEXT_PUBLIC_ 로 시작하는 것만
#                    클라이언트 번들에 인라인된다. 브라우저가 Supabase 에 직접 요청하려면
#                    이 경로로 들어와야 한다.
#
# vinext 의 탐색 순서(Next.js 와 동일, 앞이 우선):
#   process.env > .env.<mode>.local > .env.local > .env.<mode> > .env
#
# 값이 없으면 vinext 는 클라이언트 번들의 process.env 를 빈 객체로 인라인한다.
# 그러면 `{}.NEXT_PUBLIC_SUPABASE_URL ?? ""` 가 되어 빈 문자열이 되고,
# isSupabaseConfigured() 가 false 가 되어 /signup·/login 이 폼 대신
# "계정 기능이 아직 연결되지 않았습니다" 화면을 띄운다. 실제로 그렇게 배포돼 있었다.
#
# ── 설정 방법 ────────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사하고 값을 채운다(.env.local 은 .gitignore 대상이다).
#   cp .env.example .env.local
# 값은 Supabase 대시보드 → Project Settings → API 에서 확인한다.
# 자세한 절차는 docs/operations/DEPLOY_ENV.md 를 본다.

# Supabase 프로젝트 URL. 형식: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# publishable 키(sb_publishable_… ). 구형 프로젝트라면 아래 ANON 키를 대신 쓴다.
# 이 두 값은 **브라우저에 노출되도록 설계된 공개 값**이다. 실제 보호는 RLS 가 한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# publishable 키가 없는 구형 프로젝트용 대체 이름. 둘 중 하나만 있으면 된다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 여기에 절대 넣지 말 것 ───────────────────────────────────────────────────
# service_role 키, secret 키(sb_secret_…), OAuth client secret, DB 비밀번호,
# 관리자 토큰. NEXT_PUBLIC_ 접두사가 붙은 값은 전부 브라우저 번들에 그대로 들어간다.
# scripts/preflight-env.mjs 가 이런 값이 들어오면 배포를 막는다.
