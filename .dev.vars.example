# 로컬 개발용 환경변수 예시 — 키 이름만 기재한다.
# 실제 값은 무추적 파일 .dev.vars 에만 두고, 절대 커밋하지 않는다.
# 프로덕션은 `npx wrangler secret put <이름>` 으로 등록한다.

# Solar(Upstage) API
UPSTAGE_API_KEY=
SOLAR_MODEL=

# 데모 접근 게이트 (#6) — 없으면 fail-closed(데모 분석 불가)
GATE_ACCESS_CODE=
GATE_SESSION_SECRET=

# 카카오톡 공유 (#10) — JavaScript 키. 없으면 카카오 공유 버튼 미표시
KAKAO_JS_KEY=

# Gemini(AI Studio) — 공개 YouTube 영상 학습 자료 생성. 없으면 학습 자료 생성 비활성
GEMINI_API_KEY=

# K-MOOC 강좌정보 API(공공데이터포털) 인증키. Endpoint는 비밀이 아니므로 app/lib/kmooc.ts 상수
KMOOC_SERVICE_KEY=
